{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a1-scout",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Private: the Worker runs first on every path, so no page or asset is served before sign-in (see signedIn).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // Private dashboard lives on workers.dev, where the agents post (SCOUT_URL). scout.organizedai.vip belongs to the
  // public site (repo a1-scout-docs); claiming it here would take the domain back on deploy and break pairing.
  "workers_dev": true,
  "preview_urls": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "a1-scout", "database_id": "b4d37b4f-f34c-46af-b02d-b1633ec8e67b" }
  ],
  // A1 Bench: pending blind battles (1 h TTL) and Elo per suite (elo:<suite>). Runs and votes live in D1.
  "kv_namespaces": [
    { "binding": "BENCH", "id": "de9d7f9c94b842bf90d32a93aaf40db9" }
  ],
  // Coding sessions (src/sessions.js): every accepted bundle, kept past Workers Logs' 7 days.
  // Lifecycle (not deployed from here): rule "sessions-ia-180" moves sessions/ to Infrequent Access after 180 days.
  //   npx wrangler r2 bucket lifecycle add a1-scout-sessions sessions-ia-180 sessions/ --ia-transition-days 180
  "r2_buckets": [
    { "binding": "SESSION_LOGS", "bucket_name": "a1-scout-sessions" }
  ],
  // One data point per changed session per sync (blobs: host, source, app, model, project, day, session digest;
  // doubles: turns, edits, errors, active min, tokens in/out/cache read/cache write, events, subagents).
  "analytics_engine_datasets": [
    { "binding": "SESSION_METRICS", "dataset": "a1_scout_sessions" }
  ],
  // Weekly scan + session alerts: Mondays 13:00 UTC (8am Austin). The Mac agent can also ask for a scan on mount.
  // Tuesdays 13:00 UTC: session alerts only, re-run for Macs that synced late.
  "triggers": { "crons": ["0 13 * * 1", "0 13 * * 2"] },
  "vars": {
    "ORG": "Organized-AI",
    "AUTO_APPROVE": "on",
    "AUTO_APPROVE_MAX_GB": "6",
    "AUTO_APPROVE_MIN_SCORE": "70",
    "AUTO_APPROVE_PER_WEEK": "3",
    "MAX_PICK_GB": "40",
    // Docs waitlist: the survey after sign-up is this Typeform (hidden fields waitlist_id, email, name, company).
    "TYPEFORM_FORM_ID": "IrpS5S9p"
  },
  "observability": { "enabled": true }
}
