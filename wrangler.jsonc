{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "a1-scout",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Private: the Worker runs first on every path, so no page or asset is served before sign-in (see signedIn).
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  // The agents still post to workers.dev (SCOUT_URL). Turn workers_dev off once every agent points at the custom domain.
  "workers_dev": true,
  "preview_urls": false,
  "routes": [{ "pattern": "scout.organizedai.vip", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "a1-scout", "database_id": "b4d37b4f-f34c-46af-b02d-b1633ec8e67b" }
  ],
  // A1 Bench: pending blind battles (1 h TTL) and Elo per suite (elo:<suite>). Runs and votes live in D1.
  "kv_namespaces": [
    { "binding": "BENCH", "id": "de9d7f9c94b842bf90d32a93aaf40db9" }
  ],
  // Weekly scan: Mondays 13:00 UTC (8am Austin). The Mac agent can also ask for a scan on mount.
  "triggers": { "crons": ["0 13 * * 1"] },
  "vars": {
    "ORG": "Organized-AI",
    "AUTO_APPROVE": "on",
    "AUTO_APPROVE_MAX_GB": "6",
    "AUTO_APPROVE_MIN_SCORE": "70",
    "AUTO_APPROVE_PER_WEEK": "3",
    "MAX_PICK_GB": "40"
  },
  "observability": { "enabled": true }
}
